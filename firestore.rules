rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write only their own profile
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // trusted + invites are written only by Cloud Functions; owner may read
      match /trusted/{cid} { allow read: if request.auth.uid == uid; }
      match /invites/{oid}  { allow read: if request.auth.uid == uid; }
    }
    // Audit: owner can read their own sharing history; writes only by functions
    match /audit/{id} {
      allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
    // Location shares are never readable by clients (served via viewShare function)
    match /shares/{id} { allow read, write: if false; }
  }
}
